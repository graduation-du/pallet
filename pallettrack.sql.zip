--
-- Table structure for table `movements`
--

CREATE TABLE `movements` (
  `id` varchar(191) NOT NULL,
  `pallet_id` varchar(191) NOT NULL,
  `user_id` varchar(191) DEFAULT NULL,
  `action` enum('register','load','dispatch','deliver','return_pickup','receive_factory','mark_damaged','begin_repair','complete_repair','retire','mark_lost','admin_override') NOT NULL,
  `from_status` enum('available','loaded','in_transit','delivered','returning','damaged','under_repair','retired','lost') DEFAULT NULL,
  `to_status` enum('available','loaded','in_transit','delivered','returning','damaged','under_repair','retired','lost') DEFAULT NULL,
  `payload` longtext CHARACTER SET utf8mb4 COLLATE utf8mb4_bin DEFAULT NULL CHECK (json_valid(`payload`)),
  `note` varchar(500) DEFAULT NULL,
  `created_at` datetime(3) NOT NULL DEFAULT current_timestamp(3)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

